{
  "manifest_version": 3,
  "name": "StatRun for FACEIT — CheatMeter, Elo & Cross-Platform Stats",
  "version": "2.0.0",
  "description": "Elo deltas, win prediction, map veto stats, CheatMeter risk scores and Premier/Leetify cross-platform ranks — inside FACEIT match rooms and Steam profiles.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options.html",
  "permissions": ["storage", "notifications"],
  "host_permissions": [
    "https://csrun.win/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.faceit.com/*"],
      "js": [
        "src/lib/api.js",
        "src/badge.js",
        "src/faceit.js",
        "src/matchroom.js",
        "src/profile.js",
        "src/automation.js"
      ],
      "css": ["src/tokens.css", "src/styles.css", "src/matchroom.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamcommunity.com/profiles/*",
        "https://steamcommunity.com/id/*"
      ],
      "js": ["src/lib/api.js", "src/badge.js", "src/steam.js"],
      "css": ["src/tokens.css", "src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
